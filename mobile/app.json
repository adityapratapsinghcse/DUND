{
  "expo": {
    "name": "DEGRADE Trainee",
    "slug": "degrade-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gov.defence.degrade"
    },
    "android": {
      "package": "gov.defence.degrade",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow DEGRADE to stream tactical GPS position to the exercise simulation server for accurate jamming zone calculation."
        }
      ]
    ]
  }
}
