# Django Backend Settings
DEBUG=True
SECRET_KEY=degrade-insecure-dev-key-change-in-production-sih2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (Leave empty for SQLite in dev, or configure PostgreSQL)
# DATABASE_URL=postgres://degrade:degrade_pass@localhost:5432/degrade_db

# Redis & Channels (Leave empty for In-Memory Layer in local dev)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1

# CORS & Frontend URLs
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# Frontend Vite Settings (web/)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
VITE_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Mobile Settings (mobile/)
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000
