{
  "name": "defence-sih-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DEGRADE - Immersive Multi-Domain Decision-Making Trainer for Degraded Communication Environments (SIH 2026 PS ID 26248)",
  "workspaces": [
    "web",
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=web run dev",
